import Fast.Check8
import BeatAvg.K8.Excl
import Std.Data.HashMap
/-!
Generator of `BeatAvg/K8/L7G.lean` (the levels of six and seven points grouped by prefix, and the
excluded patterns of eight points) and `BeatAvg/K8/L7X.lean` (the certificates of
non-realizability for seven points). 25 minutes.
  lake env lean --load-dynlib=.lake/build/lib/libBeatAvg_Fast.so gen/GenL7.lean
-/
open BeatAvg.K8

partial def hexD (n d : Nat) : String :=
  if d ≤ 16 then
    let s := String.ofList (Nat.toDigits 16 n)
    String.ofList (List.replicate (d - s.length) '0') ++ s
  else
    let h := d / 2
    hexD (n >>> (4 * h)) (d - h) ++ hexD (n % 2 ^ (4 * h)) h

def hex (n : Nat) : String := if n < 1000 then toString n else "0x" ++ hexD n (n.log2 / 4 + 1)

def toNested (n : Nat) (P : Array Nat) : List Nat :=
  (ordQ n).map fun q => P.getD ((Fast.combos n).idxOf q) 0

/-- combos-order pattern of a nested-order list of trits -/
def toCombos (n : Nat) (l : List Nat) : Array Nat :=
  ((Fast.combos n).map fun q => l.getD ((ordQ n).idxOf q) 0).toArray

def groupLevel (n : Nat) (R : Array (Array Nat)) : Grouped :=
  let k := (ordQ (n - 1)).length
  let m : Std.HashMap Nat (List Nat) := R.foldl (fun m P =>
    let t := toNested n P
    let key := packL (t.take k)
    m.insert key (packL (t.drop k) :: (m.getD key []))) {}
  let w := 2 * (triples (n - 1)).length
  (m.toList.mergeSort (fun a b => a.1 ≤ b.1)).map fun (key, es) =>
    let es := es.mergeSort (· ≤ ·)
    (key, es.length, es.foldr (fun e acc => e + acc * 2 ^ w) 0)

/-- pack a certificate whose positions refer to `combos n` -/
def packCert (n : Nat) (c : Fast.Cert) : Nat :=
  c.length + 16 * (c.foldr (fun e acc =>
    let q := (Fast.combos n).getD e.1 (0, 0, 0, 0)
    ((ordQ n).idxOf q + 128 * e.2.1 + 256 * e.2.2) + acc * 2 ^ 20) 0)

def main : IO Unit := do
  let G6 := groupLevel 6 Fast.R6
  let G7 := groupLevel 7 Fast.R7
  IO.println s!"G6 {G6.length} G7 {G7.length}"
  let trip := fun (g : Nat × Nat × Nat) => s!"({hex g.1}, {g.2.1}, {hex g.2.2})"
  let lst := fun (xs : List String) => "[" ++ ",\n  ".intercalate xs ++ "]"
  -- level 7: excluded candidates
  let mut xrows : List String := []
  let mut tot := 0
  let mut bad := 0
  let mut maxw := 0
  for U in allCodes 10 20 G6 do
    let grp := unpackE 40 (lookupG G7 U).1 (lookupG G7 U).2
    let cands := (extsAll G6 20 6 U).filter fun x => !grp.contains x
    let mut xs := 0
    let mut cs := 0
    let mut k := 0
    for x in cands.reverse do
      let N := U + x * 4 ^ 15
      let P := toCombos 7 (unpackL N 35 0)
      match Fast.fm[(7, Fast.patCode P)]? with
      | some c =>
        let pc := packCert 7 c
        if !(exclK 7 35 N pc) then bad := bad + 1
        if c.length > 8 then bad := bad + 1
        maxw := max maxw (c.foldl (fun m e => max m e.2.2) 0)
        xs := x + xs * 2 ^ 40
        cs := pc + cs * 2 ^ 168
        k := k + 1
      | none => bad := bad + 1
    tot := tot + k
    xrows := s!"({hex U}, {k}, {hex xs}, {hex cs})" :: xrows
  IO.println s!"level 7: {tot} excluded candidates, {bad} problems, largest weight {maxw}"
  -- level 8: the excluded patterns
  let mut x8 : List String := []
  let mut n8 := 0
  for (key, c) in Fast.fm.toList do
    if key.1 == 8 then
      -- decode the pattern code (base 3, combos order)
      let P := (List.range 70).foldl (fun (acc : Array Nat × Nat) _ => (acc.1.push (acc.2 % 3), acc.2 / 3)) (#[], key.2)
      let N := packL (toNested 8 P.1)
      let pc := packCert 8 c
      if !(exclK 8 70 N pc) then IO.println "bad certificate at level 8"
      x8 := s!"({hex N}, {hex pc})" :: x8
      n8 := n8 + 1
  IO.println s!"level 8: {n8} excluded patterns"
  let hdr := fun (title : String) =>
    "import BeatAvg.K8.Search\n\n/-!\n# " ++ title ++ " (generated by `gen/GenL7.lean`)\n-/\n\nset_option maxRecDepth 100000\nset_option maxHeartbeats 0\n\nnamespace BeatAvg.K8.D\n\n"
  let mut s := hdr "Levels of six and seven points, grouped by prefix"
  s := s ++ "def G6 : Grouped := " ++ lst (G6.map trip) ++ "\n\n"
  s := s ++ "def G7 : Grouped := " ++ lst (G7.map trip) ++ "\n\n"
  s := s ++ "def X8 : List (Nat × Nat) := " ++ lst x8 ++ "\n\nend BeatAvg.K8.D\n"
  IO.FS.writeFile "BeatAvg/K8/L7G.lean" s
  let x := hdr "Certificates of non-realizability for seven points" ++
    "def X7 : List (Nat × Nat × Nat × Nat) := " ++ lst xrows.reverse ++ "\n\nend BeatAvg.K8.D\n"
  IO.FS.writeFile "BeatAvg/K8/L7X.lean" x
  IO.println s!"written, {s.length + x.length} characters"

#eval main
