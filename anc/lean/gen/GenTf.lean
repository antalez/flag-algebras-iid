import BeatAvg.K8.Tb
import BeatAvg.K8.EvalF
/-!
Generator of `BeatAvg/K8/TablesF.lean` (the grouped tables of the specialised evaluation):
  lake env lean gen/GenTf.lean
-/
open BeatAvg.K8

partial def hexD (n d : Nat) : String :=
  if d ≤ 16 then
    let s := String.ofList (Nat.toDigits 16 n)
    String.ofList (List.replicate (d - s.length) '0') ++ s
  else
    let h := d / 2
    hexD (n >>> (4 * h)) (d - h) ++ hexD (n % 2 ^ (4 * h)) h

def hex (n : Nat) : String := if n < 1000 then toString n else "0x" ++ hexD n (n.log2 / 4 + 1)

def main : IO Unit := do
  let t := D.tb
  -- for each new subset, the quadruple of its complement and the last point
  let kq : List Nat := (List.range 56).filterMap fun i =>
    let s := subs5.getD i []
    if s.contains 7 then
      let comp := (List.range 7).filter fun p => !s.contains p
      some (2 * posQ8 (comp.getD 0 0, comp.getD 1 0, comp.getD 2 0, 7) - 70)
    else none
  let quads := (List.range 35).map fun k => 70 + 2 * k
  let masks := ((thrFlat t).map fun it => Nat.shiftRight it.1 105).eraseDups
  let f := tfSpec t kq quads masks
  IO.println s!"sNew {f.sNew.length} sqG {(f.sqG.map (·.length)).sum} sqR {f.sqR.length} degG {(f.degG.map (·.length)).sum} degQ {(f.degQ.map (·.2.length)).sum} thrG {f.thrG.length} items {(f.thrG.map (·.2.1)).sum} objO {f.objO.length} objN {f.objN.length}"
  let tup4 := fun (e : Nat × Nat × Nat × Nat) => s!"({e.1}, {e.2.1}, {e.2.2.1}, {hex e.2.2.2})"
  let tup5 := fun (e : Nat × Nat × Nat × Nat × Nat) => s!"({e.1}, {e.2.1}, {e.2.2.1}, {e.2.2.2.1}, {e.2.2.2.2})"
  let lst := fun (xs : List String) => "[" ++ ",\n  ".intercalate xs ++ "]"
  let lst1 := fun (xs : List String) => "[" ++ ", ".intercalate xs ++ "]"
  let mut s := "/-!\n# Grouped tables of the specialised evaluation (generated by `gen/GenTf.lean`)\n\nRaw data only; `BeatAvg/K8/Tb.lean` assembles them.\n-/\n\nset_option maxRecDepth 100000\nset_option maxHeartbeats 0\n\nnamespace BeatAvg.K8.D\n\n"
  s := s ++ "def sNew : List (Nat × Nat × Nat × Nat × Nat) := " ++ lst (f.sNew.map tup5) ++ "\n\n"
  s := s ++ "def kq : List Nat := " ++ lst1 (f.kq.map toString) ++ "\n\n"
  s := s ++ "def sqG : List (List (Nat × Nat × Nat × Nat)) := " ++ lst (f.sqG.map fun g => lst1 (g.map tup4)) ++ "\n\n"
  s := s ++ "def degG : List (List (Nat × Nat × Nat × Nat)) := " ++ lst (f.degG.map fun g => lst1 (g.map tup4)) ++ "\n\n"
  s := s ++ "def sqR : List (Nat × Nat × Nat × Nat) := " ++ lst (f.sqR.map tup4) ++ "\n\n"
  s := s ++ "def degQ : List (Nat × List (Nat × Nat × Nat × Nat)) := " ++ lst (f.degQ.map fun g => s!"({g.1}, " ++ lst1 (g.2.map tup4) ++ ")") ++ "\n\n"
  s := s ++ "def quads : List Nat := " ++ lst1 (quads.map toString) ++ "\n\n"
  s := s ++ "def masks : List Nat := " ++ lst (masks.map hex) ++ "\n\n"
  let mut i := 0
  for g in f.thrG do
    s := s ++ s!"def thrG{i} : Nat × Nat × List (Nat × Nat) := ({hex g.1}, {g.2.1}, " ++ lst (g.2.2.map fun it => s!"({hex it.1}, {hex it.2})") ++ ")\n\n"
    i := i + 1
  s := s ++ "def thrG : List (Nat × Nat × List (Nat × Nat)) := " ++ lst1 ((List.range f.thrG.length).map fun i => s!"thrG{i}") ++ "\n\n"
  s := s ++ "def objO : List Nat := " ++ lst (f.objO.map hex) ++ "\n\n"
  s := s ++ "def objN : List Nat := " ++ lst (f.objN.map hex) ++ "\n\nend BeatAvg.K8.D\n"
  IO.FS.writeFile "BeatAvg/K8/TablesF.lean" s
  IO.println s!"written, {s.length} characters"

#eval main
