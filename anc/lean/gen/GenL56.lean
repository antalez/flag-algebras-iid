import Fast.Check8
import BeatAvg.K8.Excl
import Std.Data.HashMap
/-!
Generator of `BeatAvg/K8/L56.lean`: the levels of four and five points grouped by prefix, and the
certificates of non-realizability for five and six points.
  lake env lean --load-dynlib=.lake/build/lib/libBeatAvg_Fast.so gen/GenL56.lean
-/
open BeatAvg.K8

partial def hexD (n d : Nat) : String :=
  if d ≤ 16 then
    let s := String.ofList (Nat.toDigits 16 n)
    String.ofList (List.replicate (d - s.length) '0') ++ s
  else
    let h := d / 2
    hexD (n >>> (4 * h)) (d - h) ++ hexD (n % 2 ^ (4 * h)) h

def hex (n : Nat) : String := if n < 1000 then toString n else "0x" ++ hexD n (n.log2 / 4 + 1)

def toNested (n : Nat) (P : Array Nat) : List Nat :=
  (ordQ n).map fun q => P.getD ((Fast.combos n).idxOf q) 0

/-- combos-order pattern of a nested-order list of trits -/
def toCombos (n : Nat) (l : List Nat) : Array Nat :=
  ((Fast.combos n).map fun q => l.getD ((ordQ n).idxOf q) 0).toArray

def groupLevel (n : Nat) (R : Array (Array Nat)) : Grouped :=
  let k := (ordQ (n - 1)).length
  let m : Std.HashMap Nat (List Nat) := R.foldl (fun m P =>
    let t := toNested n P
    let key := packL (t.take k)
    m.insert key (packL (t.drop k) :: (m.getD key []))) {}
  let w := 2 * (triples (n - 1)).length
  (m.toList.mergeSort (fun a b => a.1 ≤ b.1)).map fun (key, es) =>
    let es := es.mergeSort (· ≤ ·)
    (key, es.length, es.foldr (fun e acc => e + acc * 2 ^ w) 0)

/-- pack a certificate whose positions refer to `combos n` -/
def packCert (n : Nat) (c : Fast.Cert) : Nat :=
  c.length + 16 * (c.foldr (fun e acc =>
    let q := (Fast.combos n).getD e.1 (0, 0, 0, 0)
    ((ordQ n).idxOf q + 128 * e.2.1 + 256 * e.2.2) + acc * 2 ^ 20) 0)

/-- excluded candidates of level `m + 1` from the levels `G` (m points) and `G'` -/
def xrowsOf (G G' : Grouped) (wb wb' m sh len : Nat) : IO (List String × Nat) := do
  let mut xrows : List String := []
  let mut tot := 0
  for U in allCodes sh wb G do
    let grp := unpackE wb' (lookupG G' U).1 (lookupG G' U).2
    let cands := (extsAll G wb m U).filter fun x => !grp.contains x
    let mut xs := 0
    let mut cs := 0
    let mut k := 0
    for x in cands.reverse do
      let N := U + x * 2 ^ (2 * (ordQ m).length)
      let P := toCombos (m + 1) (unpackL N len 0)
      match Fast.fm[(m + 1, Fast.patCode P)]? with
      | some c =>
        let pc := packCert (m + 1) c
        if !(exclK (m + 1) len N pc) then IO.println s!"bad certificate {m + 1}"
        xs := x + xs * 2 ^ wb'
        cs := pc + cs * 2 ^ 168
        k := k + 1
      | none => IO.println s!"missing certificate {m + 1}"
    tot := tot + k
    xrows := s!"({hex U}, {k}, {hex xs}, {hex cs})" :: xrows
  return (xrows.reverse, tot)

def main : IO Unit := do
  let G4 := groupLevel 4 Fast.R4
  let G5 := groupLevel 5 Fast.R5
  let G6 := groupLevel 6 Fast.R6
  let trip := fun (g : Nat × Nat × Nat) => s!"({hex g.1}, {g.2.1}, {hex g.2.2})"
  let lst := fun (xs : List String) => "[" ++ ",\n  ".intercalate xs ++ "]"
  let (x5, t5) ← xrowsOf G4 G5 2 8 4 0 10
  let (x6, t6) ← xrowsOf G5 G6 8 20 5 2 15
  IO.println s!"G4 {G4.length} G5 {G5.length}; excluded: level 5 {t5}, level 6 {t6}"
  let mut s := "import BeatAvg.K8.Search\n\n/-!\n# Levels of four and five points, certificates for five and six points (generated by `gen/GenL56.lean`)\n-/\n\nset_option maxRecDepth 100000\nset_option maxHeartbeats 0\n\nnamespace BeatAvg.K8.D\n\n"
  s := s ++ "def G4 : Grouped := " ++ lst (G4.map trip) ++ "\n\n"
  s := s ++ "def G5 : Grouped := " ++ lst (G5.map trip) ++ "\n\n"
  s := s ++ "def X5 : List (Nat × Nat × Nat × Nat) := " ++ lst x5 ++ "\n\n"
  s := s ++ "def X6 : List (Nat × Nat × Nat × Nat) := " ++ lst x6 ++ "\n\nend BeatAvg.K8.D\n"
  IO.FS.writeFile "BeatAvg/K8/L56.lean" s
  IO.println s!"written, {s.length} characters"

#eval main
