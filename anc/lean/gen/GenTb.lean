import Fast.Check8
import BeatAvg.K8.Eval
/-!
Generator of `BeatAvg/K8/Tables.lean` (run with the compiled `Fast` library loaded):
  lake env lean --load-dynlib=.lake/build/lib/libBeatAvg_Fast.so gen/GenTb.lean
-/
open BeatAvg.K8 Fast

/-- hexadecimal digits of `n`, exactly `d` of them (`n < 16^d`), by halving -/
partial def hexD (n d : Nat) : String :=
  if d ≤ 16 then
    let s := String.ofList (Nat.toDigits 16 n)
    String.ofList (List.replicate (d - s.length) '0') ++ s
  else
    let h := d / 2
    hexD (n >>> (4 * h)) (d - h) ++ hexD (n % 2 ^ (4 * h)) h

def hex (n : Nat) : String := "0x" ++ hexD n (n.log2 / 4 + 1)

def zmax (z : Z4) : Nat := max (max z.a.natAbs z.b.natAbs) (max z.c.natAbs z.d.natAbs)

/-- fields `value + off`, lowest first -/
def packF (w off : Nat) (vs : List Int) : Nat :=
  vs.foldr (fun v acc => (v + (off : Int)).toNat + acc * 2 ^ w) 0

def z4l (z : Z4) : List Int := [z.a, z.b, z.c, z.d]

def lists (l : List (List Nat)) : List Nat := l.map (fun x => x.length)

def main : IO Unit := do
  let t := tabs8
  let asNat := fun (l : List (Fin 8)) => l.map (·.val)
  -- compiled arrangements
  let sqT := repsSq.map (compSq ∘ asNat)
  let degT := repsDeg.map (compDeg ∘ asNat)
  let thrT := repsThr.map (compThr ∘ asNat)
  let objT := repsObj.map (compObj ∘ asNat)
  IO.println s!"compDegOk: {repsDeg.all (compDegOk ∘ asNat)}"
  -- flags and classes
  let ftP := (List.range 2430).foldr (fun k acc => (t.ft.getD k 0) % 300 + acc * 512) 0
  let ctP := (List.range 1215).foldr (fun k acc => (t.ct.getD k 0) + acc * 256) 0
  -- Q
  let bq := (t.QZ.foldl (fun m z => max m (zmax z)) 0).log2 + 1
  let offQ := 2 ^ (bq + 1)
  let wQ := bq + 2 + 10
  let row := fun (f : Nat) => if f < 300 then
      (List.range 300).foldr (fun j acc => packF wQ offQ (z4l (t.QZ.getD (f * 300 + j) Z4.zero)) + acc * 2 ^ (4 * wQ)) 0
    else 0
  let QT := (List.range 7).map fun a => (List.range 7).map fun b => (List.range 7).map fun c => row (49 * a + 7 * b + c)
  -- degree entries
  let dEntry := fun (cls s : Nat) =>
    let lo := t.loZ.getD cls Z4.zero
    let hi := t.hiZ.getD cls Z4.zero
    let U := (lo.mul ((Z4.ofInt (s : Int)).sub b4)).sub (Z4.smul (s : Int) hi)
    (U, hi)
  let allD := (List.range 150).flatMap fun cls => (List.range 5).map fun s => dEntry cls s
  let bd := (allD.foldl (fun m e => max m (max (zmax e.1) (zmax e.2))) 0).log2 + 1
  let offD := 2 ^ (bd + 1)
  let wD := bd + 2 + 10
  let rowD := fun (cls : Nat) => if cls < 150 then
      (List.range 5).foldr (fun s acc => let e := dEntry cls s; packF wD offD (z4l e.1 ++ z4l e.2) + acc * 2 ^ (8 * wD)) 0
    else 0
  let DT := (List.range 12).map fun a => (List.range 13).map fun b => rowD (13 * a + b)
  -- threshold entries
  let tE := (List.range 8).map fun θ =>
    let w1 := t.w1Z.getD θ Z4.zero
    let w2 := t.w2Z.getD θ Z4.zero
    ((Z4.smul (-4) w1, Z4.zero), (Z4.smul 4 w2, Z4.zero), (Z4.zero.sub (w2.mul b4), w1))
  let bt := (tE.foldl (fun m e => max m (max (max (zmax e.1.1) (zmax e.2.1.1)) (max (zmax e.2.2.1) (zmax e.2.2.2)))) 0).log2 + 1
  let offT := 2 ^ (bt + 1)
  let wT := bt + 2 + 13
  let pk := fun (e : Z4 × Z4) => packF wT offT (z4l e.1 ++ z4l e.2)
  let TT := tE.map fun e => (pk e.1, pk e.2.1, pk e.2.2)
  IO.println s!"bits: Q {bq} D {bd} T {bt}; sizes sq {sqT.length} deg {degT.length} thr {thrT.length} obj {objT.length}"
  let tup4 := fun (e : Nat × Nat × Nat × Nat) => s!"({e.1}, {e.2.1}, {e.2.2.1}, {hex e.2.2.2})"
  let tup3h := fun (e : Nat × Nat × Nat) => s!"({hex e.1}, {hex e.2.1}, {hex e.2.2})"
  let tup5 := fun (e : Nat × Nat × Nat × Nat × Nat) => s!"({e.1}, {e.2.1}, {e.2.2.1}, {e.2.2.2.1}, {e.2.2.2.2})"
  let lst := fun (xs : List String) => "[" ++ ",\n  ".intercalate xs ++ "]"
  let mut s := "/-!\n# Tables of the kernel evaluation (generated by `gen/GenTb.lean`)\n\nRaw data only; the rows of `Dn · Q` are in `TablesQ.lean`, and `BeatAvg/K8/Tb.lean` assembles\nthe tables.\n-/\n\nset_option maxRecDepth 100000\nset_option maxHeartbeats 0\n\nnamespace BeatAvg.K8.D\n\n"
  s := s ++ "def sub5 : List (Nat × Nat × Nat × Nat × Nat) := " ++ lst (sub5Spec.map tup5) ++ "\n\n"
  s := s ++ "def sq : List (Nat × Nat × Nat × Nat) := " ++ lst (sqT.map tup4) ++ "\n\n"
  s := s ++ "def deg : List (Nat × Nat × Nat × Nat) := " ++ lst (degT.map tup4) ++ "\n\n"
  s := s ++ "def thr : List (Nat × List (Nat × Nat × Nat)) := " ++ lst (thrT.map fun e => s!"({hex e.1}, " ++ lst (e.2.map tup3h) ++ ")") ++ "\n\n"
  s := s ++ "def obj : List Nat := " ++ lst (objT.map hex) ++ "\n\n"
  s := s ++ s!"def ftP : Nat := {hex ftP}\n\ndef ctP : Nat := {hex ctP}\n\n"
  let mut sQ := "/-!\n# Rows of `Dn · Q` (generated by `gen/GenTb.lean`)\n-/\n\nset_option maxRecDepth 100000\nset_option maxHeartbeats 0\n\nnamespace BeatAvg.K8.D\n\n"
  let mut i := 0
  for a in QT do
    for b in a do
      sQ := sQ ++ s!"def q{i} : List Nat := " ++ lst (b.map hex) ++ "\n\n"
      i := i + 1
  sQ := sQ ++ "def QT : List (List (List Nat)) := " ++ lst ((List.range 7).map fun a => "[" ++ ", ".intercalate ((List.range 7).map fun b => s!"q{7 * a + b}") ++ "]") ++ "\n\nend BeatAvg.K8.D\n"
  IO.FS.writeFile "BeatAvg/K8/TablesQ.lean" sQ
  s := s ++ "def DT : List (List Nat) := " ++ lst (DT.map fun r => "[" ++ ", ".intercalate (r.map hex) ++ "]") ++ "\n\n"
  s := s ++ "def TT : List (Nat × Nat × Nat) := " ++ lst (TT.map tup3h) ++ "\n\n"
  s := s ++ s!"def wQ : Nat := {wQ}\n\ndef offQ : Nat := {hex offQ}\n\ndef wD : Nat := {wD}\n\ndef offD : Nat := {hex offD}\n\ndef wT : Nat := {wT}\n\ndef offT : Nat := {hex offT}\n\ndef Dn : Int := {t.Dn}\n\ndef encLo : Int := {cert8.encLo}\n\ndef encHi : Int := {cert8.encHi}\n\ndef encM : Nat := {cert8.encM}\n\nend BeatAvg.K8.D\n"
  IO.FS.writeFile "BeatAvg/K8/Tables.lean" s
  IO.println s!"written, {s.length} characters"

#eval main
