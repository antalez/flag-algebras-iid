set_option maxHeartbeats 0 in
theorem int_w2 :
    Fast.cert8.w2.toList.all (Fast.K.integralAt Fast.cert8.Dn) = true := by decide +kernel

set_option maxRecDepth 100000000 in
set_option maxHeartbeats 0 in
theorem encl8 :
    Fast.enclosureOk Fast.cert8.encLo Fast.cert8.encHi Fast.cert8.encM = true := by decide +kernel

set_option maxRecDepth 100000000 in
set_option maxHeartbeats 0 in
theorem w8 : Fast.wOk Fast.cert8 = true := by decide +kernel

set_option maxRecDepth 100000000 in
set_option maxHeartbeats 0 in
theorem mult8 : Fast.multOk Fast.cert8 = true := by decide +kernel

set_option maxRecDepth 100000000 in
set_option maxHeartbeats 0 in
theorem dn8 : decide (0 < Fast.cert8.Dn) = true := by decide +kernel

set_option maxRecDepth 100000000 in
