/-!
# The static checks of the order-8 certificate, evaluated by the kernel

Generated by `data/gen_static8.py`. `Y` is symmetric and `Y - G^T G / 4^gT` is diagonally dominant
(modules `S8/Psd*`, `S8/Sym*`), the tables are integral (`S8/Int*`), and the small checks below.
This module and the modules `S8/*` import only the library `Fast`.
-/

namespace BeatAvg

theorem psd_rows : (List.range 255).all (Fast.rowOkI Fast.cert8) = true := by
  have e : List.range 255 = List.range' 0 16 ++ List.range' 16 16 ++ List.range' 32 16 ++ List.range' 48 16 ++ List.range' 64 16 ++ List.range' 80 16 ++ List.range' 96 16 ++ List.range' 112 16 ++ List.range' 128 16 ++ List.range' 144 16 ++ List.range' 160 16 ++ List.range' 176 16 ++ List.range' 192 16 ++ List.range' 208 16 ++ List.range' 224 16 ++ List.range' 240 15 := by
    decide +kernel
  rw [e]
  simp only [List.all_append, S8.psd_0, S8.psd_1, S8.psd_2, S8.psd_3, S8.psd_4, S8.psd_5, S8.psd_6, S8.psd_7, S8.psd_8, S8.psd_9, S8.psd_10, S8.psd_11, S8.psd_12, S8.psd_13, S8.psd_14, S8.psd_15, Bool.and_self]

theorem sym_rows : (List.range 255).all (Fast.symRow Fast.cert8) = true := by
  have e : List.range 255 = List.range' 0 64 ++ List.range' 64 64 ++ List.range' 128 64 ++ List.range' 192 63 := by
    decide +kernel
  rw [e]
  simp only [List.all_append, S8.sym_0, S8.sym_1, S8.sym_2, S8.sym_3, Bool.and_self]

theorem int_rows : (List.range 300).all (Fast.intRow Fast.cert8) = true := by
  have e : List.range 300 = List.range' 0 10 ++ List.range' 10 10 ++ List.range' 20 10 ++ List.range' 30 10 ++ List.range' 40 10 ++ List.range' 50 10 ++ List.range' 60 10 ++ List.range' 70 10 ++ List.range' 80 10 ++ List.range' 90 10 ++ List.range' 100 10 ++ List.range' 110 10 ++ List.range' 120 10 ++ List.range' 130 10 ++ List.range' 140 10 ++ List.range' 150 10 ++ List.range' 160 10 ++ List.range' 170 10 ++ List.range' 180 10 ++ List.range' 190 10 ++ List.range' 200 10 ++ List.range' 210 10 ++ List.range' 220 10 ++ List.range' 230 10 ++ List.range' 240 10 ++ List.range' 250 10 ++ List.range' 260 10 ++ List.range' 270 10 ++ List.range' 280 10 ++ List.range' 290 10 := by
    decide +kernel
  rw [e]
  simp only [List.all_append, S8.int_0, S8.int_1, S8.int_2, S8.int_3, S8.int_4, S8.int_5, S8.int_6, S8.int_7, S8.int_8, S8.int_9, S8.int_10, S8.int_11, S8.int_12, S8.int_13, S8.int_14, S8.int_15, S8.int_16, S8.int_17, S8.int_18, S8.int_19, S8.int_20, S8.int_21, S8.int_22, S8.int_23, S8.int_24, S8.int_25, S8.int_26, S8.int_27, S8.int_28, S8.int_29, Bool.and_self]

set_option maxRecDepth 100000000 in
set_option maxHeartbeats 0 in
theorem shape8 : Fast.shapeOk Fast.cert8 = true := by decide +kernel

set_option maxRecDepth 100000000 in
set_option maxHeartbeats 0 in
theorem int_lo :
    Fast.cert8.lo.toList.all (Fast.K.integralAt Fast.cert8.Dn) = true := by decide +kernel

set_option maxRecDepth 100000000 in
set_option maxHeartbeats 0 in
theorem int_hi :
    Fast.cert8.hi.toList.all (Fast.K.integralAt Fast.cert8.Dn) = true := by decide +kernel

set_option maxRecDepth 100000000 in
set_option maxHeartbeats 0 in
theorem int_w1 :
    Fast.cert8.w1.toList.all (Fast.K.integralAt Fast.cert8.Dn) = true := by decide +kernel

