/-!
# All patterns of `D.L6` pass the check (generated by `data/gen_six.py`)

The modules `Chk/P*` evaluate `eval6` in the kernel on consecutive ranges of `D.L6`.
-/

namespace BeatAvg.Six

/-- Split a list into consecutive ranges. -/
def pieces (l : List (List Nat)) : List (Nat × Nat) → List (List Nat)
  | [] => []
  | (lo, cnt) :: rest => (l.drop lo).take cnt ++ pieces l rest

def ranges : List (Nat × Nat) :=
  [(0, 30), (30, 30), (60, 30), (90, 30), (120, 30), (150, 30), (180, 30), (210, 30), (240, 30), (270, 30), (300, 30), (330, 30), (360, 30), (390, 30), (420, 30), (450, 30), (480, 30), (510, 30), (540, 30), (570, 30), (600, 30), (630, 30), (660, 30), (690, 30), (720, 30), (750, 30), (780, 30), (810, 30), (840, 30), (870, 30), (900, 30), (930, 30), (960, 30), (990, 30), (1020, 30), (1050, 30), (1080, 30), (1110, 30), (1140, 30), (1170, 30), (1200, 30), (1230, 30), (1260, 30)]

set_option maxRecDepth 100000000 in
set_option maxHeartbeats 0 in
theorem pieces_eq : pieces D.L6 ranges = D.L6 := by decide +kernel

theorem all_checks : D.L6.all eval6 = true := by
  have h : (pieces D.L6 ranges).all eval6 = true := by
    simp only [pieces, ranges, List.all_append, List.all_nil, Bool.and_true, Chk.p0, Chk.p1, Chk.p2, Chk.p3, Chk.p4, Chk.p5, Chk.p6, Chk.p7, Chk.p8, Chk.p9, Chk.p10, Chk.p11, Chk.p12, Chk.p13, Chk.p14, Chk.p15, Chk.p16, Chk.p17, Chk.p18, Chk.p19, Chk.p20, Chk.p21, Chk.p22, Chk.p23, Chk.p24, Chk.p25, Chk.p26, Chk.p27, Chk.p28, Chk.p29, Chk.p30, Chk.p31, Chk.p32, Chk.p33, Chk.p34, Chk.p35, Chk.p36, Chk.p37, Chk.p38, Chk.p39, Chk.p40, Chk.p41, Chk.p42, Bool.and_self]
  rwa [pieces_eq] at h

end BeatAvg.Six
